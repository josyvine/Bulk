<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_900">

    <!-- Top App Bar / Title Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/slate_800"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/bulk"
                android:contentDescription="Bulk Logo" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Content Containers (Three Tab Layouts) -->
    <FrameLayout
        android:id="@+id/container_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_bar">

        <!-- 1. Dashboard Tab Container -->
        <ScrollView
            android:id="@+id/container_convert"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:minHeight="48dp"
                    android:text="@string/select_files"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/indigo_600"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_browse" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/selected_files_header"
                    android:textColor="@color/gray_300"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Recycler view for selected files -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_selected_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_weight="1"
                    android:layout_marginBottom="16dp"/>

                <!-- Empty state container with Logo and Text -->
                <LinearLayout
                    android:id="@+id/tv_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/bulk"
                        android:alpha="0.5"
                        android:contentDescription="Bulk Logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/no_files_selected"
                        android:textColor="@color/gray_400"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_screenshots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/generate_screenshots"
                    android:textColor="@color/white"
                    android:enabled="false"
                    app:backgroundTint="@color/emerald_600"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_screenshot" />

            </LinearLayout>
        </ScrollView>

        <!-- 2. Settings Tab Container -->
        <ScrollView
            android:id="@+id/container_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/settings_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Lines per chunk -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_lines_per_chunk"
                    android:textColor="@color/gray_300"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_lines_per_chunk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/slate_800"
                    android:hint="500"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray_400" />

                <!-- Font size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_size"
                    android:textColor="@color/gray_300"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/slate_800"
                    android:hint="12"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray_400" />

                <!-- Screenshot width -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_screenshot_width"
                    android:textColor="@color/gray_300"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_screenshot_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/slate_800"
                    android:hint="1024"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray_400" />

                <!-- Folder prefix -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_folder_prefix"
                    android:textColor="@color/gray_300"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_folder_prefix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/slate_800"
                    android:hint="bulk screenshot"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray_400" />

                <!-- Output Format -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_output_format"
                    android:textColor="@color/gray_300"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <RadioGroup
                    android:id="@+id/rg_output_format"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_jpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="24dp"
                        android:text="JPG"
                        android:textColor="@color/white"
                        android:buttonTint="@color/indigo_600"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_png"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PNG"
                        android:textColor="@color/white"
                        android:buttonTint="@color/indigo_600" />
                </RadioGroup>

                <!-- JPEG Quality Slider -->
                <LinearLayout
                    android:id="@+id/layout_jpeg_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_jpeg_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPEG Quality (80%)"
                        android:textColor="@color/gray_300"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/sb_jpeg_quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:max="100"
                        android:progress="80" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 3. Explore Tab Container -->
        <ScrollView
            android:id="@+id/container_explore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/slate_800"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/explore_guide_title"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/explore_guide_body"
                            android:textColor="@color/gray_300"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.2" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_pictures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/btn_open_pictures"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/indigo_600"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_gallery" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Banner Ad View -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-2223803405403727/9277702713"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/adView"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
